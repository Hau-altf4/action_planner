PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
API_KEY_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret
# Để trống nếu không cần tạo tài khoản quản trị khi khởi động.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên
MONGODB_URI=mongodb://127.0.0.1:27017/action_planner
MONGODB_DB=action_planner
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_CHAT_NUM_CTX=1024
# Để trống để backend tự dùng số luồng CPU hợp lý
OLLAMA_NUM_THREAD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Giọng nói tiếng Việt bằng https://github.com/NTT123/vietTTS
# Trỏ đến thư mục vietTTS đã cài và đã tải mô hình bằng scripts/quick_start.sh
# `device` ưu tiên phản hồi tức thì bằng TTS có sẵn trên điện thoại.
# Đổi sang `viettts` hoặc `vietvoice` nếu muốn tổng hợp âm thanh ở backend.
VOICE_ENGINE=device
VIETTTS_DIR=C:\duong-dan\vietTTS
VIETTTS_PYTHON=python
VIETTTS_LEXICON=assets/infore/lexicon.txt
VIETTTS_TIMEOUT_MS=120000

# Để chọn giọng nam/nữ và vùng Bắc/Trung/Nam, dùng VietVoice-TTS:
# https://github.com/nguyenvulebinh/VietVoice-TTS
# Cài package trong thư mục dự án rồi đổi thành:
# VOICE_ENGINE=vietvoice
# VIETTTS_DIR=C:\duong-dan\VietVoice-TTS
# VIETTTS_PYTHON=C:\duong-dan\action_planner\backend\.venv\Scripts\python.exe
# VIETVOICE_MODEL_CACHE=C:\duong-dan\action_planner\backend\models\vietvoice
# VIETVOICE_FFMPEG_DIR=C:\duong-dan\action_planner\backend\tools\win32
# VIETVOICE_NFE_STEP=2
# VIETVOICE_SPEED=1.15
# VOICE_CACHE_DIR=C:\duong-dan\action_planner\backend\cache\voice
